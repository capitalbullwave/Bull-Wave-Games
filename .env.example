# API Core Config
PROJECT_NAME="Bull Wave Games API"
SECRET_KEY="super_secret_jwt_signing_key_bull_wave_games_123!"
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=30

# Database
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=4234
POSTGRES_DB=kheladda

# Async and Sync Database URLs will be assembled dynamically, 
# but you can override them here if desired:
# DATABASE_URL=postgresql+asyncpg://postgres:4234@localhost:5432/kheladda

# Redis Broker / Cache
REDIS_URL=redis://localhost:6379/0

# AWS S3 Storage (Avatar & Support ticket attachments)
AWS_ACCESS_KEY_ID=mock_access_key
AWS_SECRET_ACCESS_KEY=mock_secret_key
AWS_S3_BUCKET=bullwave-assets
AWS_S3_ENDPOINT_URL=https://s3.amazonaws.com

# Razorpay Sandbox
RAZORPAY_KEY_ID=rzp_test_mockkey
RAZORPAY_KEY_SECRET=mocksecret12345
RAZORPAY_WEBHOOK_SECRET=mockwebhooksecret

# Cashfree Sandbox
CASHFREE_APP_ID=mock_cf_app_id
CASHFREE_SECRET_KEY=mock_cf_secret_key
CASHFREE_API_VERSION=2022-09-01

# MLM Commissions Tiers
REFERRAL_COMMISSION_L1=0.05
REFERRAL_COMMISSION_L2=0.03
REFERRAL_COMMISSION_L3=0.01

# Security Thresholds
OTP_EXPIRE_MINUTES=5
FAILED_LOGIN_LIMIT=5
LOCKOUT_DURATION_MINUTES=15
